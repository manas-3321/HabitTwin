# HabitTwin Backend Environment Variables
# Get a free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Cloud PostgreSQL Database (e.g. Supabase, Neon, Render Postgres)
# If omitted, HabitTwin automatically uses lightweight JSON/SQLite persistence.
# DATABASE_URL=postgresql://user:password@host:5432/habittwin

# JWT Secret for Session Authentication
JWT_SECRET=habittwin_secure_jwt_secret_key_change_in_production

# Automated 6-Month Certificate Email Dispatch:
# Option A (Recommended): Resend API Key (https://resend.com - 3000 free emails/mo)
RESEND_API_KEY=
RESEND_FROM=HabitTwin Awards <onboarding@resend.dev>

# Option B: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=HabitTwin Awards <your_email@gmail.com>

